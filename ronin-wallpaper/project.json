      "quotelayout": {
        "order": 413, "text": "Quote placement", "type": "combo", "value": "0",
        "options": [
          { "label": "Under the clock", "value": "0" },
          { "label": "On its own (use sliders)", "value": "1" }
        ]
      },
      "quotex": { "order": 414, "text": "Quote left / right", "type": "slider", "min": 0, "max": 100, "step": 1, "value": 50, "editable": true, "condition": "quotelayout.value == 1" },
