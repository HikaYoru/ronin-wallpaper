      "showtodo": { "order": 500, "text": "Show to-do list", "type": "bool", "value": true },
      "todotitle": { "order": 501, "text": "To-do title", "type": "textinput", "value": "Tasks", "condition": "showtodo.value == true" },
      "todotext": { "order": 502, "text": "To-do items, separated by ;  (click an item on the desktop to tick it)", "type": "textinput", "value": "", "condition": "showtodo.value == true" },
      "todox": { "order": 503, "text": "To-do left / right", "type": "slider", "min": 0, "max": 100, "step": 1, "value": 0, "editable": true, "condition": "showtodo.value == true" },
      "todoy": { "order": 504, "text": "To-do up / down", "type": "slider", "min": 0, "max": 100, "step": 1, "value": 55, "editable": true, "condition": "showtodo.value == true" },
      "todoscale": { "order": 505, "text": "To-do size", "type": "slider", "min": 50, "max": 250, "step": 5, "value": 100, "editable": true, "condition": "showtodo.value == true" }
    }
