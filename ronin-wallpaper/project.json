        "options": [ { "label": "Celsius", "value": "0" }, { "label": "Fahrenheit", "value": "1" } ]
      },
      "showweather": { "order": 93, "text": "Show weather under the date", "type": "bool", "value": true, "condition": "liveweather.value == true" },

