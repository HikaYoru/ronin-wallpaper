      "font": {
        "order": 340, "text": "Font", "type": "combo", "value": "0",
        "options": [
          { "label": "Cinzel (carved)", "value": "0" },
          { "label": "Cormorant (elegant)", "value": "1" },
          { "label": "Shippori Mincho (brush)", "value": "2" }
        ]
      },
      "uiscale": { "order": 350, "text": "Overall size", "type": "slider", "min": 25, "max": 300, "step": 5, "value": 100, "editable": true },
